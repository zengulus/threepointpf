{
  "name": "@threepointpf/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/copy-dice-assets.mjs && vite",
    "build": "node ../../scripts/copy-dice-assets.mjs && tsc -p tsconfig.json && vite build",
    "build:pages": "node ../../scripts/copy-dice-assets.mjs && tsc -p tsconfig.json && VITE_APP_MODE=browser vite build --base=./",
    "build:hosted": "node ../../scripts/copy-dice-assets.mjs && tsc -p tsconfig.json && VITE_APP_MODE=hosted vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@3d-dice/dice-box-threejs": "^0.0.12",
    "@threepointpf/dice": "workspace:*",
    "@threepointpf/rules-core": "workspace:*",
    "@threepointpf/rules-data": "workspace:*",
    "@threepointpf/rules-schema": "workspace:*",
    "@threepointpf/shared": "workspace:*",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "vite": "^6.0.7"
  }
}
