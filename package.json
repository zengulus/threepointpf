{
  "name": "threepointpf",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "corepack pnpm --recursive --if-present build",
    "build:demo": "corepack pnpm build && corepack pnpm --filter @threepointpf/web build:pages",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:edge": "npx --yes deno@2.3.0 check --config supabase/functions/deno.json supabase/functions/character-state/index.ts supabase/functions/roll-plan/index.ts supabase/functions/resolve-roll/index.ts",
    "rules:import-autosheet": "node scripts/import-autosheet.mjs --write",
    "rules:check-autosheet": "node scripts/import-autosheet.mjs --check",
    "check:demo": "node scripts/check-demo-base.mjs",
    "dev": "corepack pnpm --filter @threepointpf/web dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "fengari": "0.1.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "xlsx": "^0.18.5"
  }
}
